# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VikiMedic v2 Environment Variables
VITE_APP_ENV="DEVELOPMENT" # DEVELOPMENT | STAGING | PRODUCTION
VITE_SUPABASE_URL="https://viki-medic-clinic.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder.anon.key"
VITE_LOG_LEVEL="DEBUG" # DEBUG | INFO | WARN | ERROR | CRITICAL
VITE_ENABLE_TAURI_NATIVE="true"
